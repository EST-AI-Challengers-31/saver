# Dahum private gateway.
# Host :9000 -> Dahum Caddy :80 -> Spring Boot :8080.
# React is built into Spring Boot, so there is no separate frontend host port.
# Public HTTPS is terminated by the existing MOVEAI Caddy on host 80/443.
:80 {
    encode zstd gzip

    reverse_proxy backend:8080 {
        # Preserve public request information through:
        # MOVEAI Caddy -> Dahum Caddy -> Spring Boot.
        header_up Host {http.request.host}
        header_up X-Forwarded-Host {http.request.header.X-Forwarded-Host}
        header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
        header_up X-Forwarded-Port {http.request.header.X-Forwarded-Port}
    }
}
