# Copy this file ONCE to:
#   C:/home/dahum/runtime/.env
# The real file must never be committed.

# Host/runtime
DAHUM_RUNTIME=C:/home/dahum/runtime
DAHUM_HOST_PORT=9000
PUBLIC_DOMAIN=yellow.it.kr
PUBLIC_BASE_URL=https://yellow.it.kr

# Existing MOVEAI reverse proxy. Keep automatic mutation disabled by default; add the yellow.it.kr route to MOVEAI Caddy once and commit it there.
MOVEAI_ROOT=C:/MOVEAI
OUTER_CADDY_AUTO_CONFIGURE=false
# Enable only after DNS/public access is known to work from the mini PC itself.
VERIFY_PUBLIC_URL=false

# MariaDB
MARIADB_IMAGE=mariadb:11.4
MARIADB_DATABASE=dahum
MARIADB_USER=dahum_app
MARIADB_PASSWORD=SPRINGDATASOURCEPASSWORD
MARIADB_ROOT_PASSWORD=MARIADBROOTPASSWORD

# Spring Boot
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mariadb://mariadb:3306/dahum
SPRING_DATASOURCE_USERNAME=dahum_app
SPRING_DATASOURCE_PASSWORD=SPRINGDATASOURCEPASSWORD
AI_BASE_URL=http://ai:8000
SERVER_FORWARD_HEADERS_STRATEGY=framework

# Social login - server-side only. Placeholder values are fine for the deployment smoke test
# because OAuth is not enabled in this first-build code yet.
KAKAO_CLIENT_ID=CHANGE_ME
KAKAO_CLIENT_SECRET=CHANGE_ME
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

# External AI/OCR services. The current FastAPI smoke-test endpoint does not call them yet.
CLOVA_OCR_API_KEY=CHANGE_ME
LLM_API_KEY=CHANGE_ME
PINECONE_API_KEY=CHANGE_ME
PINECONE_INDEX=CHANGE_ME

# Do not guess these values. Replace them after validation before RAG is enabled.# RAG - 현재 배포 확인용 임시값
RAG_SIMILARITY_THRESHOLD=0.80
RAG_TOP_K=5

# Manual recovery only. GitHub Actions overrides these with the exact commit SHA image tags.
BACKEND_IMAGE=ghcr.io/est-ai-challengers-31/saver-backend:latest
AI_IMAGE=ghcr.io/est-ai-challengers-31/saver-ai:latest
