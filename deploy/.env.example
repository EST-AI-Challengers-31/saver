# =========================================================
# Dahum 환경변수 참고 파일
# 실제 운영 서버에서는 이 파일을 사용하지 않습니다.
#
# 실제 값은 GitHub Actions의
# Secrets / Variables에서 관리합니다.
#
# 비밀번호, API 키 등 실제 민감정보를
# 이 파일에 직접 적어서 GitHub에 올리지 마세요.
# =========================================================


# =========================================================
# 서버 / 실행 환경
# =========================================================

DAHUM_RUNTIME=C:/home/dahum/runtime
# 닿음 서비스의 데이터/실행 파일이 저장되는 서버 폴더

DAHUM_HOST_PORT=9000
# 닿음 서비스가 미니PC에서 사용하는 포트 번호

PUBLIC_DOMAIN=yellow.it.kr
# 외부에서 접속할 때 사용하는 도메인

PUBLIC_BASE_URL=https://yellow.it.kr
# 닿음 서비스의 전체 외부 접속 주소


# =========================================================
# 기존 MOVEAI 리버스 프록시 설정
# =========================================================

MOVEAI_ROOT=C:/MOVEAI
# 기존 MOVEAI 프로젝트가 설치된 위치

OUTER_CADDY_AUTO_CONFIGURE=false
# 닿음 배포 과정에서 기존 MOVEAI Caddy 설정을 자동 수정할지 여부
# 현재는 false 유지

VERIFY_PUBLIC_URL=false
# 배포 과정에서 외부 도메인 접속까지 확인할지 여부
# 현재는 false 유지


# =========================================================
# MariaDB 데이터베이스
# =========================================================

MARIADB_IMAGE=mariadb:11.4
# 사용할 MariaDB Docker 이미지 버전

MARIADB_DATABASE=dahum
# 닿음 서비스에서 사용할 데이터베이스 이름

MARIADB_USER=dahum_app
# 닿음 서비스 전용 DB 사용자 이름

MARIADB_PASSWORD=SPRINGDATASOURCEPASSWORD
# GitHub Secret에서 관리
# 닿음 서비스가 DB에 접속할 때 사용하는 비밀번호

MARIADB_ROOT_PASSWORD=MARIADBROOTPASSWORD
# GitHub Secret에서 관리
# MariaDB 관리자(root) 비밀번호


# =========================================================
# Spring Boot 백엔드 설정
# =========================================================

SPRING_PROFILES_ACTIVE=prod
# Spring Boot 실행 환경
# prod = 운영 환경

SPRING_DATASOURCE_URL=jdbc:mariadb://mariadb:3306/dahum
# Spring Boot가 MariaDB에 접속하는 내부 주소
# Docker 내부 통신이므로 그대로 사용

SPRING_DATASOURCE_USERNAME=dahum_app
# Spring Boot에서 사용하는 DB 사용자 이름

SPRING_DATASOURCE_PASSWORD=SPRINGDATASOURCEPASSWORD
# GitHub Secret에서 관리
# MARIADB_PASSWORD와 같은 값을 사용

AI_BASE_URL=http://ai:8000
# Spring Boot가 FastAPI AI 서버에 접속하는 Docker 내부 주소

SERVER_FORWARD_HEADERS_STRATEGY=framework
SESSION_COOKIE_SECURE=true
# HTTPS / 프록시 환경에서 원래 요청 정보를 Spring이 인식하도록 하는 설정


# =========================================================
# 카카오 로그인
# =========================================================

KAKAO_CLIENT_ID=KAKAOCLIENTID
# GitHub Secret에서 관리
# 카카오 Developers에서 발급받은 REST API 키

KAKAO_CLIENT_SECRET=KAKAOCLIENTSECRET
# GitHub Secret에서 관리
# 카카오 Client Secret을 사용하는 경우 입력
# 사용하지 않는 경우 코드 설정에 따라 생략 가능


# =========================================================
# 외부 AI / OCR 서비스
# =========================================================

CLOVA_OCR_API_KEY=CHANGE_ME
# GitHub Secret에서 관리
# 네이버 CLOVA OCR API 인증키

LLM_API_KEY=LLMAPIKEY
UPSTAGE_API_KEY=CHANGE_ME
ALAN_CLIENT_ID=CHANGE_ME
# GitHub Secret에서 관리
# 사용하는 LLM 서비스의 API 키

PINECONE_API_KEY=NOT_CONFIGURED_YET
# GitHub Secret에서 관리
# Pinecone 벡터 데이터베이스 API 키

PINECONE_INDEX=NOT_CONFIGURED_YET
# GitHub Variable에서 관리
# Pinecone에서 사용하는 인덱스 이름


# =========================================================
# Ellen API
# 정보 조회용 AP
# =========================================================

ELLEN_API_BASE_URL=NOT_CONFIGURED_YET
# GitHub Variable에서 관리
# Ellen API의 기본 주소

ELLEN_API_KEY=NOT_CONFIGURED_YET
# GitHub Secret에서 관리
# Ellen API 인증키


# =========================================================
# RAG 검색 설정
# 현재는 테스트용 임시값
# =========================================================

RAG_SIMILARITY_THRESHOLD=0.80
# 검색 결과가 얼마나 비슷해야 사용할지 정하는 기준값
# 0~1 사이 숫자
# 실제 서비스 적용 전 테스트를 통해 조정 예정

RAG_TOP_K=5
# 검색 결과 중 상위 몇 개를 AI에게 전달할지 정하는 값
# 현재는 상위 5개 사용


# =========================================================
# 배포 상태 확인
# =========================================================

DEPLOY_HEALTH_MODE=full
# React/Spring뿐 아니라 MariaDB와 FastAPI 상태까지 확인한 뒤 배포 성공으로 판단


# =========================================================
# Docker 이미지
# =========================================================

BACKEND_IMAGE=ghcr.io/est-ai-challengers-31/saver-backend:latest
# Spring Boot + React가 포함된 백엔드 Docker 이미지
# 실제 자동 배포 시 GitHub Actions가 정확한 버전으로 변경

AI_IMAGE=ghcr.io/est-ai-challengers-31/saver-ai:latest
# FastAPI AI 서버 Docker 이미지
# 실제 자동 배포 시 GitHub Actions가 정확한 버전으로 변경


# =========================================================
# clova_ocr_api
# =========================================================

CLOVA_OCR_URL=https://example.apigw.ntruss.com/custom/v1/PROJECT/DOMAIN/general
CLOVA_OCR_SECRET=CHANGE_ME
